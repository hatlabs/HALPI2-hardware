(version 1)

# Routing clearances live in the netclasses so that tools which do not read
# custom rules see them. The rules here only widen spacing to pours, guard the
# HV and isolation boundaries, and constrain diff-pair tuning.
#
# Later rules take precedence over earlier ones.

########################################################################################
## Pour pullback

(rule "zone_pullback"
    (condition "((A.Type == 'Pad') || (A.Type == 'Track') || (A.Type == 'Zone')) && (B.Type == 'Zone')")
    (constraint clearance (min 0.3mm)))

# At 0.1 mm, pours leave slivers between vias and cut off via-fed islands.
# 0.15 mm also keeps the JLCPCB 0.2 mm inner-layer hole-to-copper clearance
# between pours and the smallest via (0.4/0.3 mm).

(rule "via_zone_pullback"
    (condition "(A.Type == 'Via') && (B.Type == 'Zone')")
    (constraint clearance (min 0.15mm)))

# 90 ohm tracks keep 2W to pours; 100 ohm tracks use zone_pullback.

(rule "diff_90ohm_zone_pullback"
    (condition "(A.Type == 'Track') && A.hasNetclass('Diff90ohm') && (B.Type == 'Zone')")
    (layer outer)
    (constraint clearance (min 0.315mm)))

(rule "diff_pair_via_zone_pullback"
    (condition "(A.Type == 'Via') && (A.hasNetclass('Diff90ohm') || A.hasNetclass('Diff100ohm')) && (B.Type == 'Zone')")
    (constraint clearance (min 0.3mm)))

# The input-protection ground pour keeps its 0.5 mm zone clearance to tracks
# and other pours, which zone_pullback would otherwise override.

(rule "gnd_f_zone_pullback"
    (condition "((A.Type == 'Track') || (A.Type == 'Zone')) && (B.Type == 'Zone') && (B.NetName == 'GND_F')")
    (constraint clearance (min 0.5mm)))

########################################################################################
## Diff-pair tuning

# Track widths and pair gaps from the JLCPCB Impedance Calculator are in the
# Diff90ohm and Diff100ohm netclasses. Diff pairs are routed on the outer layers
# only.

(rule "ignore_diff_pattern_tuning_pair_gap"
    (condition "AB.isCoupledDiffPair() && B.Tuning_Mode=='Diff pair skew'")
    (constraint diff_pair_gap (max 1.5mm)))

(rule "max_skew"
    (constraint skew (min -0.2mm) (opt 0.0mm) (max 0.2mm) (within_diff_pairs)))

########################################################################################
## HV and isolation boundaries

# Netclass clearances cannot express these: they apply between domains, not
# within one. Tools that read only netclasses do not see them, so run DRC after
# any such tool touches HV or isolated-side copper.

(rule "HV_clearance"
    (condition "A.hasNetClass('HV') && !B.hasNetClass('HV')")
    (constraint clearance (min 1.0mm)))

# 1 mm across the CAN/RS485 isolation barrier, for all copper.

(rule "isolation_barrier_clearance"
    (condition "(A.NetName == '+5V' || A.NetName == '+3.3V' || A.NetName == 'GND') && (B.NetName == 'GND_CAN' || B.NetName == 'GND_RS485' || B.NetName == '+5V_CAN' || B.NetName == '+5V_RS485')")
    (constraint clearance (min 1.0mm)))
